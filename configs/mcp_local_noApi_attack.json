{
  "bilibili": {
    "command": "node",
    "args": ["./mcp/apps/bilibili-mcp-server/dist/index.js"]
  },
  "airbnb": {
    "command": "node",
    "args": ["./mcp/apps/mcp-server-airbnb/dist/index.js", "--ignore-robots-txt"]
  },
  "arxiv-server": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/arxiv-mcp-server/src/arxiv_server",
      "run",
      "server.py"
    ],
    "env": {
      "DOWNLOAD_PATH": "/home/llz/file_test"
    }
  },
  "arxiv-latex-mcp": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/arxiv-latex-mcp",
      "run",
      "server/main.py"
    ]
  },
  "mcp-dblp": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/mcp-dblp/",
      "run",
      "mcp-dblp",
      "--exportdir",
      "/home/llz/file_test"
    ]
  }
}
