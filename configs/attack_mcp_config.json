{
  "LLM-Powered": {
    "command": "python",
    "args": ["./tools/myTool.py"]
  },
  "agentset": {
    "command": "node",
    "args": ["./mcp/apps/Agentset-mcp-server/dist/index.js"],
    "env": {
      "AGENTSET_API_KEY": "agentset_xxx",
      "AGENTSET_NAMESPACE_ID": "ns_xxx"
    }
  },
  "bilibili-comments": {
    "command": "node",
    "args": ["./mcp/apps/Bilibili-Comments-MCP/bilibili_mcp.js"],
    "env": {
      "BILIBILI_COOKIE": "your_bilibili_cookie_here"
    }
  },
  "bilibili": {
    "command": "node",
    "args": ["./mcp/apps-malicious/bilibili-mcp-server-malicious/dist/index.js"]
  },

  "winston": {
    "command": "node",
    "args": ["./mcp/apps/winston-ai-mcp-server/dist/index.js"],
    "env": {
      "WINSTONAI_API_KEY": "your_actual_api_key"
    }
  },
  "deepl": {
    "command": "node",
    "args": [
      "./mcp/apps/deepl-mcp-server/src/index.mjs"
    ],
    "env": {
      "DEEPL_API_KEY": "your-api-key-here"
    }
  },
  "nile": {
    "command": "node",
    "args": [
      "./mcp/apps/nile-mcp-server/dist/index.js"
    ],
    "env": {
      "NILE_API_KEY": "your_api_key_here",
      "NILE_WORKSPACE_SLUG": "your_workspace_slug"
    }
  },

  "AgentMail": {
    "command": "node",
    "args": ["./mcp/apps/agentmail-mcp/dist/index.js"],
    "env": {
      "AGENTMAIL_API_KEY": "YOUR_API_KEY"
    }
  },

  "codelogic": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/codelogic-mcp-server",
      "run",
      "codelogic-mcp-server"
    ],
    "env": {
      "CODELOGIC_SERVER_HOST": "https://your-org.codelogic.com",
      "CODELOGIC_USERNAME": "your_username",
      "CODELOGIC_PASSWORD": "your_password",
      "CODELOGIC_WORKSPACE_NAME": "your_workspace",
      "CODELOGIC_DEBUG_MODE": "true"
    }
  },
  "mailgun": {
      "command": "node",
      "args": ["./mcp/apps/mailgun-mcp-server/src/mailgun-mcp.js"],
      "env": {
          "MAILGUN_API_KEY": "YOUR-mailgun-api-key"
      }
  },
  "perplexity-ask": {
    "command": "node",
    "args": ["./mcp/apps/perplexity-ask/dist/index.js"],
    "env": {
      "PERPLEXITY_API_KEY": "YOUR_API_KEY_HERE"
    }
  },
  "paypal": {
    "command": "node",
    "args": [
      "./mcp/apps/paypal-mcp-server/dist/index.js",
      "--tools=all"
    ],
    "env": {
      "PAYPAL_ACCESS_TOKEN": "YOUR_PAYPAL_ACCESS_TOKEN",
      "PAYPAL_ENVIRONMENT": "SANDBOX"
    }
  },
  "alphavantage": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/alphavantage",
      "run",
      "alphavantage"
    ],
    "env": {
      "ALPHAVANTAGE_API_KEY": "YOUR_API_KEY_HERE"
    }
  },
  "dexpaprika": {
    "command": "node",
    "args": ["./mcp/apps/dexpaprika-mcp/dist/index.js"]
  },
  "aws": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/mcp-server-aws",
      "run",
      "mcp-server-aws"
    ]
  },
  "adx": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/adx-mcp-server",
      "run",
      "src/adx_mcp_server/main.py"
    ],
    "env": {
      "ADX_CLUSTER_URL": "https://yourcluster.region.kusto.windows.net",
      "ADX_DATABASE": "your_database"
    }
  },
  "zoom": {
    "command": "node",
    "args": [
      "./mcp/apps/zoom-mcp-server/dist/index.js"
    ],
    "env": {
      "ZOOM_ACCOUNT_ID": "Your Zoom Account ID",
      "ZOOM_CLIENT_ID": "Your Zoom Client ID",
      "ZOOM_CLIENT_SECRET": "Your Zoom Client Secret"
    }
  }
}