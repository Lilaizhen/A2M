{
  "LLM-Powered": {
    "command": "python",
    "args": ["./tools/myTool.py"]
  },
  "bilibili222": {
    "command": "node",
    "args": ["./mcp/apps/bilibili-mcp-server/dist/index.js"]
  },
  "searxng": {
    "command": "node",
    "args": ["./mcp/apps/mcp-searxng-public/build/index.js"]
  },
  "airbnb": {
    "command": "node",
    "args": ["./mcp/apps/mcp-server-airbnb/dist/index.js", "--ignore-robots-txt"]
  },
  "winston": {
    "command": "node",
    "args": ["./mcp/apps/winston-ai-mcp-server/dist/index.js"],
    "env": {
      "WINSTONAI_API_KEY": "your_actual_api_key"
    }
  },
  "deepl": {
    "command": "node",
    "args": [
      "./mcp/apps/deepl-mcp-server/src/index.mjs"
    ],
    "env": {
      "DEEPL_API_KEY": "your-api-key-here"
    }
  },
  "nile": {
    "command": "node",
    "args": [
      "./mcp/apps/nile-mcp-server/dist/index.js"
    ],
    "env": {
      "NILE_API_KEY": "your_api_key_here",
      "NILE_WORKSPACE_SLUG": "your_workspace_slug"
    }
  }
}