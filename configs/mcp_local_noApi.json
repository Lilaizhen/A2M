{
  "time": {
    "command": "uvx",
    "args": ["mcp-server-time"]
  },
  "bilibili": {
    "command": "node",
    "args": ["./mcp/apps/bilibili-mcp-server/dist/index.js"]
  },
  "airbnb": {
    "command": "node",
    "args": ["./mcp/apps/mcp-server-airbnb/dist/index.js", "--ignore-robots-txt"]
  },
  "arxiv": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/arxiv-mcp-server/src/arxiv_server",
      "run",
      "server.py"
    ],
    "env": {
      "DOWNLOAD_PATH": "/home/llz/file_test"
    }
  },
  "arxiv_latex": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/arxiv-latex-mcp",
      "run",
      "server/main.py"
    ]
  },
  "dblp": {
    "command": "uv",
    "args": [
      "--directory",
      "./mcp/apps/mcp-dblp/",
      "run",
      "mcp-dblp",
      "--exportdir",
      "/home/llz/file_test"
    ]
  },
  "email": {
    "command": "uv",
    "args": [
        "--directory",
        "./mcp/apps/email-mcp-server",
        "run",
        "main.py"
    ],
    "env": {
        "SMTP_HOST": "smtp.qq.com",
        "SMTP_PORT": "465",
        "SMTP_SECURE": "true",
        "SMTP_USER": "2863845024@qq.com",
        "SMTP_FROM": "2863845024@qq.com",
        "SMTP_PASS": "xfretorptcxxddfb"
    }
  },
  "baidu-map": {
    "command": "node",
    "args": ["./mcp/apps/baidu-map-server/dist/index.js"],
    "env": {
      "BAIDU_MAP_API_KEY": "nGMJmkbk7q5klKIS4W78rdjNBiNhTPXG"
    }
  },
  "notion": {
    "command": "node",
    "args": ["./mcp/apps/notion-mcp-server/bin/cli.mjs"],
    "env": {
      "NOTION_TOKEN": "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"
    }
  }
